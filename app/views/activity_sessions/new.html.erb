<div class="phone-page mood-page mood-home-page">

  <div class="mood-topbar">
    <div class="mood-brand">
      <%= image_tag "mascot/brand-mascot.png",
                    class: "mood-brand-image",
                    alt: "Tiny Act" %>

      <span class="mood-brand-name">
        Tiny Act
      </span>
    </div>

    <div class="mood-user-actions">
      <div class="mood-xp-pill">
        <strong><%= @home_xp %></strong>
        <span>XP</span>
      </div>

      <%= link_to user_path, class: "mood-profile-link" do %>
        <%= image_tag "avatars/#{current_user.avatar || 'blueberry'}.png",
                      class: "mood-profile-avatar",
                      alt: "Profil" %>
      <% end %>
    </div>
  </div>

  <%= link_to room_path, class: "room-notification" do %>
    <div class="room-notification-visual">
      <%= image_tag "mascot/room-preview.png",
                    class: "room-notification-image",
                    alt: "" %>
    </div>

    <div class="room-notification-content">
      <strong>Ta room progresse</strong>

      <span>
        Encore <%= @actions_before_reward %>
        <%= @actions_before_reward > 1 ? "actions" : "action" %>
        avant un meuble
      </span>

      <div class="room-progress">
        <span style="width: <%= @room_progress_percent %>%;"></span>
      </div>
    </div>

    <span class="room-notification-arrow">›</span>
  <% end %>

  <div class="mood-hero mood-hero-after-room">
    <h1>
      Comment tu te sens ?
    </h1>
  </div>

  <%= form_with url: location_activity_sessions_path,
                method: :get,
                class: "mood-form" do %>

    <div class="mood-list">

      <% @moods.each do |mood| %>

        <% mood_key =
          case mood.name
          when "En forme"
            "energy"
          when "Mitigé"
            "bof"
          else
            "flat"
          end
        %>

        <% mood_label = mood.name == "Mitigé" ? "Bof" : mood.name %>

        <button
          type="submit"
          name="mood_id"
          value="<%= mood.id %>"
          class="mood-card mood-choice-card mood-choice-<%= mood_key %>"
        >

          <div class="mood-mascot-image-wrapper">
            <%= image_tag "mascot/mood-#{mood_key}.png",
                          class: "mood-mascot-image",
                          alt: "" %>
          </div>

          <div class="mood-text mood-text-simple">
            <strong>
              <%= mood_label %>
            </strong>
          </div>

          <span class="mood-card-arrow">›</span>

        </button>

      <% end %>

    </div>

  <% end %>

</div>
