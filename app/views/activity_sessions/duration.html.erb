<div class="phone-page mood-page has-bottom-action">

  <div class="mood-header">
    <div class="tiny-mascot">⏳</div>

    <h1>
      Combien de temps ?
    </h1>
  </div>

  <%= form_with url: activity_sessions_path,
                method: :post,
                class: "mood-form" do %>

    <%= hidden_field_tag :mood_id, @mood_id %>
    <%= hidden_field_tag :location_id, @location_id %>

    <div class="mood-list">

      <% @durations.each_with_index do |duration, index| %>

        <button
          type="submit"
          name="duration_id"
          value="<%= duration.id %>"
          class="mood-card <%= ["mood-green", "mood-yellow", "mood-blue"][index % 3] %>"
        >

          <div class="mood-icon">
            <% if duration.value <= 15 %>
              ⚡
            <% elsif duration.value <= 45 %>
              ☕
            <% else %>
              🌈
            <% end %>
          </div>

          <div class="mood-text mood-text-simple">
            <strong>
              <%= duration.value %> minutes
            </strong>
          </div>

        </button>

      <% end %>

    </div>

  <% end %>

  <%= link_to location_activity_sessions_path(mood_id: @mood_id),
              class: "bottom-back-button" do %>
    ← Revenir à l’étape précédente
  <% end %>

</div>
