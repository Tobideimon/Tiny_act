<div class="mood-topbar">
  <%= link_to new_activity_session_path,
              class: "mood-brand mood-brand-link",
              aria: { label: "Retour à l'accueil Tiny Act" } do %>

    <%= image_tag "brand/tiny-act-logo.png",
                  class: "mood-brand-logo",
                  alt: "Tiny Act" %>
  <% end %>

  <div class="mood-user-actions">
    <%= link_to activity_sessions_path,
                class: "mood-xp-pill mood-xp-link",
                aria: { label: "Voir mon historique d'activités" } do %>
      <strong><%= @home_xp %></strong>
      <span>XP</span>
    <% end %>

    <%= link_to user_path,
                class: "mood-profile-link",
                aria: { label: "Voir mon profil" } do %>
      <%= image_tag "avatars/#{current_user.avatar.presence || 'avatar_01'}.png",
                    class: "mood-profile-avatar",
                    alt: "Profil" %>
    <% end %>
  </div>
</div>
