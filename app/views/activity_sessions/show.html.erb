<div class="phone-page mood-page recommendations-phone-page mood-activities-page <%= "has-bottom-action" unless @activity_session&.finished? %>">

  <header class="mood-screen-header">
    <%= render "activity_sessions/selection_topbar" %>
  </header>

  <main class="mood-screen-main recommendations-page">

    <% if @activity_session.finished? %>

      <section class="session-summary">
        <div class="summary-hero">
          <p class="recommendations-kicker">Bravo</p>
          <h1>Activité terminée</h1>
          <p>Tu as choisi une vraie action plutôt qu'un scroll automatique.</p>
        </div>

        <article class="summary-main-card">
          <div class="summary-complete-badge">
            <i class="fa-solid fa-check"></i>
            <span>Terminé</span>
          </div>

          <h2><%= @activity&.name.presence || "Activité réalisée" %></h2>

          <div class="summary-meta-grid">
            <div>
              <span>Catégorie</span>
              <strong><%= @summary_interest_name %></strong>
            </div>

            <div>
              <span>Durée</span>
              <strong><%= @summary_duration_label %></strong>
            </div>

            <div>
              <span>Statut</span>
              <strong>Terminé</strong>
            </div>
          </div>
        </article>

        <div class="summary-stats-grid">
          <article class="summary-stat-card summary-stat-time">
            <span class="summary-stat-icon">
              <i class="fa-solid fa-mobile-screen-button"></i>
            </span>

            <div>
              <p>Temps d'écran gagné</p>
              <strong><%= @summary_saved_scroll_minutes %> min</strong>
              <span>Tu as évité <%= @summary_saved_scroll_minutes %> minutes de scroll.</span>
            </div>
          </article>

          <article class="summary-stat-card summary-stat-xp">
            <span class="summary-stat-icon">
              <i class="fa-solid fa-bolt"></i>
            </span>

            <div>
              <p>XP gagnée</p>
              <strong>+<%= @summary_xp_gained %> XP</strong>
              <span>Ton intérêt <%= @summary_interest_name %> progresse.</span>
            </div>
          </article>
        </div>

        <article class="summary-reward-card">
          <div class="summary-reward-icon">
            <i class="fa-solid fa-couch"></i>
          </div>

          <div>
            <p>Récompense room</p>
            <strong>Tu as gagné un nouveau meuble !</strong>
          </div>
        </article>

        <div class="summary-actions">


          <%= link_to room_path(current_user.room),
                      class: "summary-action-secondary" do %>
            Voir ma room
          <% end %>

          <%= link_to new_activity_session_path,
                      class: "primary-button summary-action-primary" do %>
            Faire une nouvelle activité
          <% end %>
        </div>
      </section>

    <% else %>

      <div class="recommendations-header">
        <p class="recommendations-kicker">Choisis une action</p>

        <h1>
          On a trouvé ça pour toi
        </h1>

      </div>

      <% if @activities.any? %>

        <div class="activities-list activities-count-<%= @activities.size %>">

          <% @activities.each_with_index do |activity, index| %>

            <% interest_name = activity.interest.name %>

              <% interest_class =
                case interest_name
                when "Sport"
                  "activity-sport"
                when "Langues"
                  "activity-langues"
                when "Créativité"
                  "activity-creativity"
                when "Bien-être"
                  "activity-wellbeing"
                when "Photo"
                  "activity-photo"
                when "Dessin"
                  "activity-drawing"
                when "Écriture"
                  "activity-writing"
                when "Culture"
                  "activity-culture"
                when "Productivité"
                  "activity-productivity"
                when "Code"
                  "activity-code"
                else
                  "activity-default"
                end
              %>

              <% activity_mascot =
                case interest_name
                when "Sport"
                  "mascot/activities/sport.png"
                when "Langues"
                  "mascot/activities/langues.png"
                when "Créativité"
                  "mascot/activities/creativite.png"
                when "Bien-être"
                  "mascot/activities/bien_etre.png"
                when "Photo"
                  "mascot/activities/photo.png"
                when "Dessin"
                  "mascot/activities/dessin.png"
                when "Écriture"
                  "mascot/activities/ecriture.png"
                when "Culture"
                  "mascot/activities/culture.png"
                when "Productivité"
                  "mascot/activities/productivite.png"
                when "Code"
                  "mascot/activities/code.png"
                else
                  nil
                end
              %>

              <% activity_category_icon =
                case interest_name
                when "Sport"
                  "fa-solid fa-person-running"
                when "Langues"
                  "fa-solid fa-language"
                when "Créativité"
                  "fa-solid fa-palette"
                when "Bien-être"
                  "fa-solid fa-spa"
                when "Photo"
                  "fa-solid fa-camera"
                when "Dessin"
                  "fa-solid fa-pen-nib"
                when "Écriture"
                  "fa-solid fa-pen"
                when "Culture"
                  "fa-solid fa-book-open"
                when "Productivité"
                  "fa-solid fa-list-check"
                when "Code"
                  "fa-solid fa-code"
                else
                  "fa-solid fa-star"
                end
              %>

            <%= link_to activity_path(
                  activity,
                  activity_session_id: @activity_session.id
                ),
                class: "activity-card-link" do %>

              <article class="activity-card <%= interest_class %>">
                <div class="activity-card-main">

                  <div class="activity-mascot-frame">
                    <% if activity_mascot.present? %>
                      <%= image_tag activity_mascot,
                                    class: "activity-mascot-image",
                                    alt: "" %>
                    <% else %>
                      <span class="activity-fallback-icon">✦</span>
                    <% end %>
                  </div>

                  <div class="activity-body">
                    <div class="activity-meta-row">
                      <span class="activity-category-ribbon">
                        <i class="<%= activity_category_icon %>"></i>
                        <%= interest_name %>
                      </span>
                    </div>

                    <div class="activity-top">
                      <h2>
                        <%= activity.name %>

                        <% if activity.language_activity? && @language_label.present? %>
                          en <%= @language_label %>
                        <% end %>
                      </h2>
                    </div>
                  </div>

                  <span class="activity-card-arrow">›</span>

                </div>
              </article>


            <% end %>

          <% end %>

        </div>

      <% else %>

        <div class="empty-state">
          <p>Aucune activité trouvée.</p>
          <%= link_to "Recommencer",
                      new_activity_session_path,
                      class: "primary-button recommendations-primary-button" %>
        </div>

      <% end %>

    <% end %>

    </main>

  <% unless @activity_session.finished? %>
    <footer class="mood-screen-footer">
      <%= link_to duration_activity_sessions_path(
                    mood_id: @activity_session.activity.mood_id,
                    location_id: @activity_session.activity.location_id
                  ),
                  class: "bottom-back-button" do %>
        ← Retour
      <% end %>
    </footer>
  <% end %>
</div>
