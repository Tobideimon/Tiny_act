<div class="phone-page recommendations-phone-page has-bottom-action">

  <%= render "activity_sessions/selection_topbar" %>

  <div class="recommendations-page">

    <% if @activity_session.finished? %>

      <div class="session-summary">
        <div class="recommendations-header">
          <p class="recommendations-kicker">Bravo</p>
          <h1>Session terminée</h1>
          <p>Tu as transformé un moment disponible en action réelle.</p>
        </div>

        <div class="activity-card activity-summary-card">
          <div class="activity-interest-header">
            <span class="activity-interest-label badge-interest">
              <%= @activity_session.activity.interest.name %>
            </span>
          </div>

          <div class="activity-top">
            <h2>
              <%= @activity_session.activity.name %>
            </h2>
          </div>

          <p class="activity-content">
            <%= @activity_session.activity.content %>
          </p>

          <div class="summary-details">
            <p>
              <strong>Date</strong>
              <span><%= @activity_session.date %></span>
            </p>

            <p>
              <strong>Mood</strong>
              <span><%= @activity_session.activity.mood.name %></span>
            </p>

            <p>
              <strong>Durée</strong>
              <span><%= @activity_session.activity.duration.value %> min</span>
            </p>

            <p>
              <strong>Lieu</strong>
              <span><%= @activity_session.activity.location.name %></span>
            </p>
          </div>
        </div>
      </div>

      <%= link_to "Recommencer",
                  new_activity_session_path,
                  class: "primary-button recommendations-primary-button" %>

    <% else %>

      <div class="recommendations-header">
        <p class="recommendations-kicker">À toi de choisir</p>

        <h1>
          Activités recommandées
        </h1>

      </div>

      <% if @activities.any? %>

        <div class="activities-list">

          <% @activities.each_with_index do |activity, index| %>

            <% interest_class =
              case activity.interest.name
              when "Sport"
                "activity-sport"
              when "Langues"
                "activity-langues"
              when "Créativité"
                "activity-creativity"
              when "Bien-être"
                "activity-wellbeing"
              when "Photo"
                "activity-photo"
              when "Dessin"
                "activity-drawing"
              when "Écriture"
                "activity-writing"
              when "Culture"
                "activity-culture"
              else
                "activity-default"
              end
            %>

            <% activity_icon =
              case activity.interest.name
              when "Sport"
                "sport.png"
              when "Langues"
                "langue.png"
              when "Créativité"
                "creativite.png"
              when "Bien-être"
                "bien_etre.png"
              when "Photo"
                "photo.png"
              when "Dessin"
                "dessin.png"
              when "Écriture"
                "ecriture.png"
              when "Culture"
                "culture.png"
              else
                nil
              end
            %>

            <%= link_to activity_path(
                  activity,
                  activity_session_id: @activity_session.id
                ),
                class: "activity-card-link" do %>

              <article class="activity-card <%= interest_class %>">
                <div class="activity-card-main">
                  <div class="activity-visual">
                    <% if activity_icon.present? %>
                      <%= image_tag activity_icon,
                                    class: "activity-interest-icon",
                                    alt: "" %>
                    <% else %>
                      <span class="activity-fallback-icon">✦</span>
                    <% end %>
                  </div>

                  <div class="activity-body">
                    <div class="activity-interest-header">
                      <span class="activity-interest-label badge-interest">
                        <%= activity.interest.name %>
                      </span>

                      <span class="activity-duration-pill">
                        <%= activity.duration.value %> min
                      </span>
                    </div>

                    <div class="activity-top">
                      <h2>
                        <%= activity.name %>

                        <% if activity.language_activity? &&
                              @language_label.present? %>
                          en <%= @language_label %>
                        <% end %>
                      </h2>
                    </div>

                    <p class="activity-content">
                      <%= activity.content %>
                    </p>
                  </div>

                  <span class="activity-card-arrow">›</span>
                </div>
              </article>

            <% end %>

          <% end %>

        </div>

      <% else %>

        <div class="empty-state">
          <p>Aucune activité trouvée.</p>
          <%= link_to "Recommencer",
                      new_activity_session_path,
                      class: "primary-button recommendations-primary-button" %>
        </div>

      <% end %>

    <% end %>

  </div>
  <% unless @activity_session.finished? %>
  <%= link_to duration_activity_sessions_path(
                mood_id: @activity_session.activity.mood_id,
                location_id: @activity_session.activity.location_id
              ),
              class: "bottom-back-button" do %>
    ← Retour
  <% end %>
<% end %>
</div>
