<div class="phone-page mood-page has-bottom-action">

  <div class="mood-header">
    <div class="tiny-mascot">📍</div>

    <h1>
      Où es-tu ?
    </h1>
  </div>

  <%= form_with url: duration_activity_sessions_path,
                method: :get,
                class: "mood-form" do %>

    <%= hidden_field_tag :mood_id, @mood_id %>

    <div class="mood-list">

      <% @locations.each_with_index do |location, index| %>

        <button
          type="submit"
          name="location_id"
          value="<%= location.id %>"
          class="mood-card <%= ["mood-green", "mood-yellow", "mood-blue"][index % 3] %>"
        >

          <div class="mood-icon">
            <% case index % 3
               when 0 %>
              🏡
            <% when 1 %>
              🌳
            <% else %>
              ☕
            <% end %>
          </div>

          <div class="mood-text mood-text-simple">
            <strong>
              <%= location.name %>
            </strong>
          </div>

        </button>

      <% end %>

    </div>

  <% end %>

  <%= link_to new_activity_session_path,
              class: "bottom-back-button" do %>
    ← Revenir à l’étape précédente
  <% end %>

</div>
