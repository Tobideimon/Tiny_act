<h1>Mes centres d'intérêt</h1>

<%= form_with url: user_interests_path, method: :patch, local: true do %>
  <% @interests.each do |interest| %>
    <div>
      <%= check_box_tag "interest_ids[]", interest.id, @selected_interest_ids.include?(interest.id) %>
      <%= label_tag "interest_ids_#{interest.id}", interest.name %>
    </div>
  <% end %>

  <%= submit_tag "Enregistrer" %>
<% end %>
