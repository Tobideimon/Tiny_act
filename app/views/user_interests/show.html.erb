<div class="phone-page mood-page user-interests-page">
  <header class="user-interests-screen-header">
    <%= render "activity_sessions/selection_topbar" %>
  </header>

  <main class="user-interests-screen-main">
    <section class="user-interests-intro">
      <p class="user-interests-kicker">Personnalisation</p>

      <div class="mood-hero setup-hero">
        <h1>Tes centres d'intérêt</h1>
      </div>

      <p class="setup-helper">
        Choisis ce que tu veux retrouver dans tes recommandations.
        On adaptera les actions à tes envies.
      </p>
    </section>

    <%= form_with url: user_interests_path,
                  method: :patch,
                  class: "interests-form" do %>

      <div class="interests-scroll-area">
        <div class="interests-grid">
          <% @interests.each do |interest| %>
            <% interest_name = interest.name %>

            <% css_class =
              case interest_name
              when "Sport"
                "interest-sport"
              when "Langues"
                "interest-langues"
              when "Bien-être"
                "interest-wellbeing"
              when "Créativité"
                "interest-creativity"
              when "Photo"
                "interest-photo"
              when "Dessin"
                "interest-drawing"
              when "Écriture"
                "interest-writing"
              when "Culture"
                "interest-culture"
              when "Code", "Programmation", "Développement"
                "interest-code"
              when "Productivité", "Productivite"
                "interest-productivity"
              else
                "interest-default"
              end
            %>

            <% interest_mascot =
              case interest_name
              when "Sport"
                "mascot/activities/sport.png"
              when "Langues"
                "mascot/activities/langues.png"
              when "Bien-être"
                "mascot/activities/bien_etre.png"
              when "Créativité"
                "mascot/activities/creativite.png"
              when "Photo"
                "mascot/activities/photo.png"
              when "Dessin"
                "mascot/activities/dessin.png"
              when "Écriture"
                "mascot/activities/ecriture.png"
              when "Culture"
                "mascot/activities/culture.png"
              when "Code", "Programmation", "Développement"
                "mascot/activities/code.png"
              when "Productivité", "Productivite"
                "mascot/activities/productivite.png"
              else
                nil
              end
            %>

            <% interest_description =
              case interest_name
              when "Sport"
                "Bouger et relancer ton énergie."
              when "Langues"
                "Apprendre quelques mots utiles."
              when "Bien-être"
                "Respirer, ralentir, te recentrer."
              when "Créativité"
                "Produire une idée ou une forme."
              when "Photo"
                "Regarder autrement ce qui t’entoure."
              when "Dessin"
                "Dessiner sans pression."
              when "Écriture"
                "Poser une idée en quelques lignes."
              when "Culture"
                "Nourrir ta curiosité."
              when "Code", "Programmation", "Développement"
                "Résoudre un petit problème."
              when "Productivité", "Productivite"
                "Clarifier et avancer."
              else
                "Ajouter cette catégorie."
              end
            %>

            <label class="interest-option">
              <%= check_box_tag(
                    "interest_ids[]",
                    interest.id,
                    @selected_interest_ids.include?(interest.id)
                  ) %>

              <span class="interest-card <%= css_class %>">
                <span class="interest-card-shine"></span>

                <span class="interest-mascot-frame">
                  <% if interest_mascot.present? %>
                    <%= image_tag interest_mascot,
                                  class: "interest-mascot-image",
                                  alt: "" %>
                  <% else %>
                    <span class="interest-fallback-icon">✦</span>
                  <% end %>
                </span>

                <span class="interest-copy">
                  <span class="interest-name">
                    <%= interest_name %>
                  </span>

                  <span class="interest-description">
                    <%= interest_description %>
                  </span>
                </span>

                <span class="interest-checkmark">
                  <i class="fa-solid fa-check"></i>
                </span>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <footer class="interests-bottom-action">
        <%= submit_tag "Enregistrer mes choix", class: "interests-submit" %>
      </footer>
    <% end %>
  </main>
</div>
