<div class="phone-page user-interests-page">
  <div class="user-interests-topbar">
    <%= render "activity_sessions/selection_topbar" %>
  </div>

  <div class="user-interests-intro">
    <div class="mood-hero setup-hero">
      <h1>Tes centres d'intérêt</h1>
    </div>

    <p class="setup-helper">
      Choisis les activités qui t'intéressent.<br>
      On te recommandera des idées rien que pour toi.
    </p>
  </div>

  <%= form_with url: user_interests_path,
                method: :patch,
                class: "interests-form" do %>

    <div class="interests-scroll-area">
      <div class="interests-grid">
        <% @interests.each do |interest| %>

          <% css_class =
            case interest.name
            when "Sport" then "interest-sport"
            when "Langues" then "interest-langues"
            when "Bien-être" then "interest-wellbeing"
            when "Créativité" then "interest-creativity"
            when "Photo" then "interest-photo"
            when "Dessin" then "interest-drawing"
            when "Écriture" then "interest-writing"
            when "Culture" then "interest-culture"
            when "Code", "Programmation", "Développement" then "interest-code"
            when "Productivité", "Productivite" then "interest-productivity"
            else "interest-disabled"
            end
          %>

          <label class="interest-option">
            <%= check_box_tag(
                  "interest_ids[]",
                  interest.id,
                  @selected_interest_ids.include?(interest.id)
                ) %>

            <span class="interest-card <%= css_class %>">
              <span class="interest-icon-shell">
                <% if interest.name == "Sport" %>
                  <%= image_tag "sport.png", class: "interest-icon" %>
                <% elsif interest.name == "Langues" %>
                  <%= image_tag "langue.png", class: "interest-icon" %>
                <% elsif interest.name == "Bien-être" %>
                  <%= image_tag "bien_etre.png", class: "interest-icon" %>
                <% elsif interest.name == "Photo" %>
                  <%= image_tag "photo.png", class: "interest-icon" %>
                <% elsif interest.name == "Dessin" %>
                  <%= image_tag "dessin.png", class: "interest-icon" %>
                <% elsif interest.name == "Écriture" %>
                  <%= image_tag "ecriture.png", class: "interest-icon" %>
                <% elsif interest.name == "Créativité" %>
                  <%= image_tag "creativite.png", class: "interest-icon" %>
                <% elsif interest.name == "Culture" %>
                  <%= image_tag "culture.png", class: "interest-icon" %>
                <% elsif ["Code", "Programmation", "Développement"].include?(interest.name) %>
                  <i class="fa-solid fa-code interest-fa-icon"></i>
                <% elsif ["Productivité", "Productivite"].include?(interest.name) %>
                  <i class="fa-solid fa-list-check interest-fa-icon"></i>
                <% end %>
              </span>

              <span class="interest-name">
                <%= interest.name %>
              </span>
            </span>
          </label>

        <% end %>
      </div>
    </div>

    <div class="interests-bottom-action">
      <%= submit_tag "Enregistrer", class: "interests-submit" %>
    </div>

  <% end %>
</div>
