<div class="phone-page auth-page auth-login-page">
  <header class="auth-topbar">
    <%= link_to root_path, class: "auth-back-button", aria: { label: "Retour" } do %>
      <i class="fa-solid fa-arrow-left"></i>
      <span>Retour</span>
    <% end %>

    <div class="auth-brand-mini">
      <%= image_tag "brand/tiny-act-logo.png",
          class: "auth-brand-logo",
          alt: "Tiny Act" %>
    </div>
  </header>

  <main class="auth-content">
    <section class="auth-hero-card">
      <div class="auth-hero-icon">
        <i class="fa-solid fa-bolt"></i>
      </div>

      <div class="auth-hero-text">
        <p class="auth-kicker">Bon retour</p>
        <h1>Connexion</h1>
        <p>Reprends tes activités, ton XP et ta room là où tu les as laissés.</p>
      </div>
    </section>

    <section class="auth-form-card">
      <div class="auth-form-heading">
        <p class="auth-kicker">Compte</p>
        <h2>Connecte-toi</h2>
      </div>

      <%= simple_form_for(resource,
            as: resource_name,
            url: session_path(resource_name),
            html: { class: "auth-form" }) do |f| %>

        <%= f.input :email,
              label: "Email",
              placeholder: "ton@email.com",
              required: false,
              autofocus: true,
              input_html: {
                autocomplete: "email",
                class: "auth-input"
              },
              wrapper_html: { class: "auth-field" } %>

        <%= f.input :password,
              label: "Mot de passe",
              placeholder: "Ton mot de passe",
              required: false,
              input_html: {
                autocomplete: "current-password",
                class: "auth-input"
              },
              wrapper_html: { class: "auth-field" } %>

        <% if devise_mapping.rememberable? %>
          <%= f.input :remember_me,
                as: :boolean,
                label: "Se souvenir de moi",
                wrapper_html: { class: "auth-remember" } %>
        <% end %>

        <%= f.button :submit,
            "Se connecter",
            class: "auth-submit-button" %>
      <% end %>
    </section>

    <section class="auth-secondary-card">
      <p>Pas encore de compte ?</p>

      <%= link_to new_user_registration_path, class: "auth-secondary-link" do %>
        <span>Créer mon profil</span>
        <i class="fa-solid fa-arrow-right"></i>
      <% end %>
    </section>

    <% if devise_mapping.recoverable? %>
      <div class="auth-forgot-link">
        <%= link_to "Mot de passe oublié ?", new_user_password_path %>
      </div>
    <% end %>
  </main>
</div>
