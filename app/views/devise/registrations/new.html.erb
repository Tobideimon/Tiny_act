<div class="phone-page auth-page auth-registration-page">
  <header class="auth-topbar">
    <%= link_to root_path, class: "auth-back-button", aria: { label: "Retour" } do %>
      <i class="fa-solid fa-arrow-left"></i>
      <span>Retour</span>
    <% end %>

    <div class="auth-brand-mini">
      <%= image_tag "brand/tiny-act-logo.png",
          class: "auth-brand-logo",
          alt: "Tiny Act" %>
    </div>
  </header>

  <main class="auth-content">
    <section class="auth-hero-card">
      <div class="auth-hero-icon">
        <i class="fa-solid fa-sparkles"></i>
      </div>

      <div class="auth-hero-text">
        <p class="auth-kicker">Bienvenue</p>
        <h1>Créer un compte</h1>
        <p>Commence Tiny Act avec ton profil, tes centres d’intérêt et ta room.</p>
      </div>
    </section>

    <section class="auth-form-card">
      <div class="auth-form-heading">
        <p class="auth-kicker">Profil</p>
        <h2>Tes infos</h2>
      </div>

      <%= simple_form_for(resource,
            as: resource_name,
            url: registration_path(resource_name),
            html: { class: "auth-form" }) do |f| %>

        <%= f.error_notification %>

        <div class="auth-name-grid">
          <%= f.input :first_name,
                label: "Prénom",
                placeholder: "Prénom",
                input_html: { class: "auth-input" },
                wrapper_html: { class: "auth-field" } %>

          <%= f.input :last_name,
                label: "Nom",
                placeholder: "Nom",
                input_html: { class: "auth-input" },
                wrapper_html: { class: "auth-field" } %>
        </div>

        <%= f.input :email,
              label: "Email",
              placeholder: "ton@email.com",
              input_html: {
                autocomplete: "email",
                class: "auth-input"
              },
              wrapper_html: { class: "auth-field" } %>

        <%= f.input :password,
              label: "Mot de passe",
              placeholder: "6 caractères minimum",
              hint: "Tu pourras modifier ton avatar après la création du compte.",
              input_html: {
                autocomplete: "new-password",
                class: "auth-input"
              },
              wrapper_html: { class: "auth-field" } %>

        <%= f.button :submit,
            "Créer mon profil",
            class: "auth-submit-button" %>
      <% end %>
    </section>

    <section class="auth-secondary-card">
      <p>Déjà un compte ?</p>

      <%= link_to new_user_session_path, class: "auth-secondary-link" do %>
        <span>Se connecter</span>
        <i class="fa-solid fa-arrow-right"></i>
      <% end %>
    </section>
  </main>
</div>
