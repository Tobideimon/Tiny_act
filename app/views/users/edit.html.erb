<div class="phone-page avatar-edit-page">
  <header class="profile-header-bar profile-title-topbar">
    <%= link_to user_path, class: "profile-back-link", aria: { label: "Retour au profil" } do %>
      <i class="fa-solid fa-arrow-left"></i>
      <span>Retour</span>
    <% end %>

    <div class="profile-page-heading">
      <h1>Avatar</h1>
      <p>Choisis ton style</p>
    </div>

    <div class="profile-header-balancer" aria-hidden="true"></div>
  </header>

  <main class="avatar-edit-content">
    <section class="avatar-edit-intro-card">
      <div class="avatar-edit-intro-icon">
        🎨
      </div>

      <div>
        <p class="avatar-edit-kicker">Apparence</p>
        <h2>Choisis ton avatar</h2>
        <p>Sélectionne un avatar, puis valide ton choix.</p>
      </div>
    </section>

    <%= form_with model: @user,
                  url: user_path,
                  method: :patch,
                  class: "avatar-form" do |f| %>

      <div class="avatar-grid">
        <% @avatars.each do |avatar| %>
          <label class="avatar-option">
            <%= f.radio_button :avatar,
                               avatar,
                               class: "avatar-radio" %>

            <div class="avatar-image-wrapper">
              <%= image_tag "avatars/#{avatar}.png",
                  class: "avatar-choice-image",
                  alt: avatar %>
            </div>
          </label>
        <% end %>
      </div>

      <div class="avatar-save-zone">
        <%= f.submit "Enregistrer mon avatar",
            class: "avatar-save-button" %>
      </div>
    <% end %>
  </main>
</div>
