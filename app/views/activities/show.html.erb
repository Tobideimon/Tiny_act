<div class="recommendations-page">

  <div class="recommendations-header">
      <% if @activity.interest.name == "Sport" %>

        <%= image_tag(
              "sport.png",
              class: "activity-interest-icon"
            ) %>

      <% elsif @activity.interest.name == "Langues" %>

        <%= image_tag(
              "langue.png",
              class: "activity-interest-icon"
            ) %>

      <% end %>

    <h1>
      <%= @activity.name %>

      <% if @activity.language_activity? && @language_label.present? %>
        en <%= @language_label %>
      <% end %>
    </h1>

    <p>
      <%= @activity.content %>
    </p>
  </div>

  <% if @activity.interest.name == "Sport" %>

    <%= render "sport",
      activity: @activity %>

  <% elsif @activity.interest.name == "Langues" %>

    <%= render "language",
      activity: @activity,
      language_items: @language_items,
      duration_seconds: @duration_seconds %>

  <% else %>

    <div class="activity-card">
      <p class="activity-content">
        <%= @activity.content %>
      </p>
    </div>

  <% end %>

  <%= button_to "Finir l'activité",
      activity_session_path(@activity_session),
      method: :patch,
      class: "temp-finish-button" %>

  <%= link_to "Recommencer",
              root_path,
              class: "primary-button" %>

</div>
