<% serialized_questions = culture_questions.map { |question|
  {
    question: question.question,
    category: question.category,
    correct_answer: question.correct_answer,
    answers: question.answers
  }
} %>

<% categories = culture_questions.map(&:category).uniq.sort %>
<% duration_seconds = activity.duration.value.to_i * 60 %>

<div
  data-controller="culture-quiz"
  data-culture-quiz-questions-value="<%= serialized_questions.to_json %>"
  data-culture-quiz-duration-seconds-value="<%= duration_seconds %>"
  data-culture-quiz-finish-url-value="<%= activity_session_path(@activity_session) %>"
  class="culture-quiz"
>
  <div
    class="culture-panel culture-start-card"
    data-culture-quiz-target="startScreen"
  >
    <div class="culture-start-header">
      <p class="culture-kicker">
        Choix du thème
      </p>

      <h2>
        Choisis ton terrain de jeu
      </h2>

      <p>
        Tu vas répondre à un maximum de questions pendant
        <strong><%= activity.duration.value %> minutes</strong>.
        Le chrono commence quand tu choisis un thème.
      </p>
    </div>

    <div class="culture-theme-list">
      <% categories.each do |category| %>
        <button
          type="button"
          class="culture-theme-button"
          data-category="<%= category %>"
          data-action="click->culture-quiz#selectCategory"
        >
          <span><%= category %></span>
          <strong>›</strong>
        </button>
      <% end %>
    </div>
  </div>

  <div
    class="culture-status-panel"
    data-culture-quiz-target="quizHeader"
    hidden
  >
    <div class="culture-status-card">
      <span>Thème</span>
      <strong data-culture-quiz-target="selectedCategory"></strong>
    </div>

    <div class="culture-status-card">
      <span>Temps</span>
      <strong data-culture-quiz-target="timer"></strong>
    </div>

    <div class="culture-status-card culture-status-wide">
      <span>Score</span>
      <strong data-culture-quiz-target="progress"></strong>
    </div>
  </div>

  <div
    class="culture-panel culture-question-card"
    data-culture-quiz-target="card"
    hidden
  >
    <p class="culture-kicker">
      Question
    </p>

    <h2 data-culture-quiz-target="question">
      Chargement de la question...
    </h2>

    <div
      class="quiz-answers"
      data-culture-quiz-target="answers"
    ></div>

    <p
      class="quiz-feedback"
      data-culture-quiz-target="feedback"
    ></p>

    <p
      class="quiz-score"
      data-culture-quiz-target="score"
    ></p>
  </div>

  <button
    type="button"
    class="culture-next-button"
    data-culture-quiz-target="nextButton"
    data-action="click->culture-quiz#nextQuestion"
    hidden
  >
    Question suivante
  </button>
</div>
