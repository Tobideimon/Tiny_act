<% sport_plan = activity.sport_activity_plan %>
<% sport_steps = sport_plan["steps"] %>

<div
  class="sport-activity"
  data-controller="sport-activity"
  data-sport-activity-plan-value="<%= json_escape(sport_plan.to_json) %>"
>
  <div class="sport-panel sport-main-card">
    <% if sport_steps.any? %>
      <div class="sport-preparation-card">
        <span class="sport-preparation-number">0</span>

        <div>
          <strong>Préparation</strong>
          <p>30 secondes pour te mettre en place avant le départ.</p>
        </div>
      </div>

      <div
        class="sport-steps-preview"
        data-sport-activity-target="stepsPreview"
      >
        <% sport_steps.each_with_index do |step, index| %>
          <div class="sport-step-card">
            <span class="sport-step-number"><%= index + 1 %></span>

            <p>
              <%= step["text"] %>
            </p>
          </div>
        <% end %>
      </div>

      <button
        type="button"
        class="primary-button sport-launch-button"
        data-sport-activity-target="launchButton"
        data-action="click->sport-activity#launch"
      >
        Lancer
      </button>
    <% else %>
      <p class="activity-show-description">
        Aucune étape détaillée pour cette activité.
      </p>
    <% end %>
  </div>

  <div
    class="sport-panel sport-runner-card is-hidden"
    data-sport-activity-target="runner"
  >
    <p class="sport-runner-label" data-sport-activity-target="runnerLabel">
      Étape <span data-sport-activity-target="currentStepNumber"></span>
      /
      <span data-sport-activity-target="totalSteps"></span>
    </p>

    <h2 data-sport-activity-target="currentStepText"></h2>

    <div
      class="sport-timer is-hidden"
      data-sport-activity-target="timerWrapper"
    >
      <span data-sport-activity-target="timer"></span>
    </div>

    <button
      type="button"
      class="secondary-button sport-next-button"
      data-sport-activity-target="nextButton"
      data-action="click->sport-activity#nextStep"
    >
      Passer cette étape
    </button>
  </div>

  <div
    class="sport-panel sport-finished-card is-hidden"
    data-sport-activity-target="finished"
  >
    <h2>Bravo</h2>

    <p class="activity-show-description">
      Tu as terminé cette activité.
    </p>
  </div>
</div>
