<% steps = activity.step_list %>

<% if steps.blank? %>
  <% steps = [
    "Observe ton environnement et choisis un sujet simple.",
    "Cherche un cadrage intéressant.",
    "Prends une photo, même imparfaite.",
    "Regarde rapidement ton image et garde celle qui raconte le mieux ton intention."
  ] %>
<% end %>

<div
  class="photo-activity"
  data-controller="photo-activity"
>
  <div
    class="photo-panel photo-main-card"
    data-photo-activity-target="startScreen"
  >
    <div class="photo-start-header">
      <p class="photo-kicker">
        Défi photo
      </p>

      <h2>
        Observe, cadre, déclenche
      </h2>

      <p>
        Prends quelques minutes pour produire une vraie image, même simple.
      </p>
    </div>

    <div class="photo-steps">
      <% steps.each_with_index do |step, index| %>
        <div class="photo-step-card">
          <span class="photo-step-number">
            <%= index + 1 %>
          </span>

          <p>
            <%= step %>
          </p>
        </div>
      <% end %>
    </div>

    <button
      type="button"
      class="primary-button photo-launch-button"
      data-photo-activity-target="launchButton"
      data-action="click->photo-activity#launch"
    >
      Lancer l’activité
    </button>
  </div>

  <div
    class="photo-panel photo-runner-card"
    data-photo-activity-target="runner"
    hidden
  >
    <p class="photo-kicker">
      Étape
      <span data-photo-activity-target="currentStepNumber"></span>
      /
      <span data-photo-activity-target="totalSteps"></span>
    </p>

    <h2 data-photo-activity-target="currentStepText"></h2>

  <div class="photo-camera-zone">
    <input
      type="file"
      accept="image/*"
      capture="environment"
      data-photo-activity-target="cameraInput"
      data-action="change->photo-activity#previewPhoto"
      hidden
    >

    <button
      type="button"
      class="photo-camera-button"
      data-action="click->photo-activity#openCamera"
    >
      <span class="photo-camera-button-icon">
        <i class="fa-solid fa-camera"></i>
      </span>

      <span>
        Prendre une photo
      </span>
    </button>

    <div
      class="photo-preview-wrapper"
      data-photo-activity-target="previewWrapper"
      hidden
    >
      <img
        class="photo-preview"
        data-photo-activity-target="preview"
        alt="Photo prise pendant l’activité"
      >

      <button
        type="button"
        class="photo-retake-button"
        data-action="click->photo-activity#openCamera"
      >
        Reprendre la photo
      </button>

      <a
        class="photo-download-button"
        data-photo-activity-target="downloadLink"
        download="tiny-act-photo.jpg"
        hidden
      >
        <i class="fa-solid fa-download"></i>
        Enregistrer la photo
      </a>
    </div>

    <p class="photo-camera-help">
      Sur mobile, l’appareil photo s’ouvrira directement si ton navigateur le permet.
    </p>
  </div>

    <button
      type="button"
      class="primary-button photo-next-button"
      data-photo-activity-target="nextButton"
      data-action="click->photo-activity#nextStep"
    >
      Étape suivante
    </button>
  </div>

  <div
    class="photo-panel photo-finished-card"
    data-photo-activity-target="finished"
    hidden
  >
    <h2>
      Photo réalisée
    </h2>

    <p class="activity-show-description">
      Tu as pris le temps d’observer, de cadrer et de produire une image.
    </p>

    <div
      class="photo-finished-preview-wrapper"
      data-photo-activity-target="finishedPreviewWrapper"
      hidden
    >
      <img
        class="photo-preview"
        data-photo-activity-target="finishedPreview"
        alt="Photo prise pendant l’activité"
      >

      <a
        class="photo-download-button"
        data-photo-activity-target="finishedDownloadLink"
        download="tiny-act-photo.jpg"
        hidden
      >
        <i class="fa-solid fa-download"></i>
        Enregistrer la photo
      </a>
    </div>
  </div>

  <script type="application/json" data-photo-activity-target="stepsData">
    <%= raw steps.to_json %>
  </script>
</div>
