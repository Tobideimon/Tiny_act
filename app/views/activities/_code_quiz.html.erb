<% pool_by_family = @code_questions_by_family || {} %>
<% duration_seconds = activity.duration.value.to_i * 60 %>

<div
  class="code-quiz"
  data-controller="code-quiz"
  data-code-quiz-questions-by-family-value="<%= pool_by_family.to_json %>"
  data-code-quiz-duration-seconds-value="<%= duration_seconds %>"
  data-code-quiz-finish-url-value="<%= activity_session_path(@activity_session) %>"
>
  <div class="code-panel code-start-card" data-code-quiz-target="startScreen">
    <div class="code-start-header">
      <p class="code-kicker">Quiz code</p>
      <h2>Choisis un thème</h2>
      <p>
        Réponds au maximum en <strong><%= activity.duration.value %> min</strong>.
        Plus la question est difficile, plus elle rapporte de points.
      </p>
    </div>

    <div class="code-theme-list">
      <% CodeQuestion::FAMILY_NAMES.each do |family| %>
        <button
          type="button"
          class="code-theme-button"
          data-family="<%= family %>"
          data-action="click->code-quiz#chooseFamily"
        >
          <span><%= family %></span>
          <strong>›</strong>
        </button>
      <% end %>
    </div>
  </div>

  <div class="code-status-panel" data-code-quiz-target="quizHeader" hidden>
    <div class="code-status-card">
      <span>Temps</span>
      <strong data-code-quiz-target="timer"></strong>
    </div>

    <div class="code-status-card">
      <span>Thème</span>
      <strong data-code-quiz-target="familyLabel"></strong>
    </div>

    <div class="code-status-card code-status-wide">
      <span>Score</span>
      <strong data-code-quiz-target="progress"></strong>
    </div>
  </div>

  <div class="code-panel code-question-card" data-code-quiz-target="card" hidden>
    <p class="code-kicker">Question</p>

    <h2 data-code-quiz-target="question">
      Chargement...
    </h2>

    <div
      class="quiz-answers code-answers"
      data-code-quiz-target="answers"
    ></div>

    <p
      class="quiz-feedback code-feedback"
      data-code-quiz-target="feedback"
    ></p>

    <p
      class="quiz-score code-score"
      data-code-quiz-target="score"
    ></p>
  </div>

  <button
    type="button"
    class="code-next-button"
    data-code-quiz-target="nextButton"
    data-action="click->code-quiz#nextQuestion"
    hidden
  >
    Question suivante
  </button>
</div>
