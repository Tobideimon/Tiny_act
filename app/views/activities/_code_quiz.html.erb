<% serialized_questions = code_questions.map { |question|
  {
    question: question.question,
    category: question.category,
    difficulty: question.difficulty,
    correct_answer: question.correct_answer,
    answers: question.answers
  }
} %>

<% duration_seconds = activity.duration.value.to_i * 60 %>

<% difficulty_label =
  case activity.mood.name
  when "À plat"
    "facile"
  when "Bof", "Mitigé"
    "intermédiaire"
  when "En forme"
    "difficile"
  else
    "facile"
  end
%>

<div
  class="code-quiz"
  data-controller="code-quiz"
  data-code-quiz-questions-value="<%= serialized_questions.to_json %>"
  data-code-quiz-duration-seconds-value="<%= duration_seconds %>"
  data-code-quiz-finish-url-value="<%= activity_session_path(@activity_session) %>"
>
  <div
    class="code-panel code-start-card"
    data-code-quiz-target="startScreen"
  >
    <div class="code-start-header">
      <p class="code-kicker">
        Quiz code
      </p>

      <h2>
        Teste tes réflexes de dev
      </h2>

      <p>
        Tu vas répondre à un maximum de questions pendant
        <strong><%= activity.duration.value %> minutes</strong>,
        avec un niveau <strong><%= difficulty_label %></strong>.
      </p>
    </div>

    <button
      type="button"
      class="code-next-button"
      data-code-quiz-target="launchButton"
      data-action="click->code-quiz#launch"
    >
      Lancer le quiz
    </button>
  </div>

  <div
    class="code-status-panel"
    data-code-quiz-target="quizHeader"
    hidden
  >
    <div class="code-status-card">
      <span>Temps</span>
      <strong data-code-quiz-target="timer"></strong>
    </div>

    <div class="code-status-card">
      <span>Niveau</span>
      <strong><%= difficulty_label %></strong>
    </div>

    <div class="code-status-card code-status-wide">
      <span>Score</span>
      <strong data-code-quiz-target="progress"></strong>
    </div>
  </div>

  <div
    class="code-panel code-question-card"
    data-code-quiz-target="card"
    hidden
  >
    <p class="code-kicker">
      Question
    </p>

    <h2 data-code-quiz-target="question">
      Chargement de la question...
    </h2>

    <div
      class="quiz-answers code-answers"
      data-code-quiz-target="answers"
    ></div>

    <p
      class="quiz-feedback code-feedback"
      data-code-quiz-target="feedback"
    ></p>

    <p
      class="quiz-score code-score"
      data-code-quiz-target="score"
    ></p>
  </div>

  <button
    type="button"
    class="code-next-button"
    data-code-quiz-target="nextButton"
    data-action="click->code-quiz#nextQuestion"
    hidden
  >
    Question suivante
  </button>
</div>
