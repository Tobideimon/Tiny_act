<% language_label = local_assigns.fetch(:language_label, @language_label) %>

<% if activity.activity_type == "word_learning" %>

  <div
    data-controller="language-activity"
    data-language-activity-items-value="<%= language_items.map { |item|
      {
        prompt: item.prompt,
        answer: item.answer,
        translation: item.translation.presence || item.answer
      }
    }.to_json %>"
    data-language-activity-duration-value="<%= duration_seconds %>"
    data-language-activity-mode-value="word_learning"
    class="language-activity language-word-activity"
  >

    <div class="language-status-panel">
      <div class="language-status-item">
        <span>Temps</span>
        <strong data-language-activity-target="timer"></strong>
      </div>

      <div class="language-status-item">
        <span>Progression</span>
        <strong data-language-activity-target="progress"></strong>
      </div>
    </div>

    <div class="language-panel language-main-card">
      <p class="language-kicker">
        Mot en <%= language_label %>
      </p>

      <h2
        class="language-word"
        data-language-activity-target="wordPrompt"
      >
        Chargement du mot...
      </h2>

      <div
        class="language-answer-box is-hidden"
        data-language-activity-target="wordAnswer"
      ></div>

      <button
        type="button"
        class="language-secondary-button"
        data-language-activity-target="revealTranslationButton"
        data-action="click->language-activity#toggleWordTranslation"
      >
        Voir la traduction
      </button>
    </div>

    <button
      type="button"
      class="language-primary-button"
      data-language-activity-target="nextButton"
      data-action="click->language-activity#nextWord"
    >
      Mot suivant
    </button>
  </div>

<% elsif activity.activity_type == "sentence_completion" %>

  <div
    data-controller="language-activity"
    data-language-activity-items-value="<%= language_items.map { |item|
      {
        prompt: item.prompt,
        answer: item.answer,
        translation: item.translation
      }
    }.to_json %>"
    data-language-activity-duration-value="<%= duration_seconds %>"
    data-language-activity-mode-value="sentence_completion"
    class="language-activity language-sentence-activity"
  >

    <div class="language-status-panel">
      <div class="language-status-item">
        <span>Temps</span>
        <strong data-language-activity-target="timer"></strong>
      </div>

      <div class="language-status-item">
        <span>Progression</span>
        <strong data-language-activity-target="progress"></strong>
      </div>
    </div>

    <div class="language-panel language-main-card">
      <p class="language-kicker">
        Phrase en français
      </p>

      <p
        class="language-translation"
        data-language-activity-target="sentenceTranslation"
      >
        Chargement de la phrase...
      </p>

      <p class="language-kicker language-kicker-spaced">
        Complète en <%= language_label %>
      </p>

      <%= form_with url: "#",
                    method: :get,
                    class: "language-sentence-form",
                    data: {
                      language_activity_target: "sentenceForm",
                      action: "submit->language-activity#checkSentence"
                    } do %>

        <p class="sentence-line">
          <span data-language-activity-target="sentenceBefore"></span>

          <input <%# herb:disable html-input-require-autocomplete %>
            type="text"
            class="sentence-gap-input"
            placeholder="___"
            data-language-activity-target="sentenceInput"
          >

          <span
            class="sentence-revealed-answer is-hidden"
            data-language-activity-target="revealedAnswer"
          ></span>

          <span data-language-activity-target="sentenceAfter"></span>
        </p>

        <button
          type="submit"
          class="language-primary-button"
          data-language-activity-target="submitButton"
        >
          Valider
        </button>

      <% end %>

      <p
        class="sentence-feedback"
        data-language-activity-target="sentenceFeedback"
      ></p>
    </div>
  </div>

<% elsif activity.activity_type == "llm_chat" %>

  <div class="language-panel">
    <p class="activity-show-description">
      Le chat avec IA sera branché plus tard.
    </p>
  </div>

<% end %>
